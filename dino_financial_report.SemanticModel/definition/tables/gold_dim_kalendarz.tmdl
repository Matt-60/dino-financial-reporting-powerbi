		lineageTag: d8db8cb7-a298-4de1-a587-13d25a768235
		summarizeBy: none
		isNameInferred
		sourceColumn: [Dzień wolny]

		annotation SummarizationSetBy = Automatic

	partition gold_dim_kalendarz = calculated
		mode: import
		source =
				
				VAR _Poczatek = DATE ( 2024, 1, 1 )
				VAR _Koniec   = DATE ( 2025, 12, 31 )
				VAR _Baza =
				    ADDCOLUMNS (
				        CALENDAR ( _Poczatek, _Koniec ),
				        "Rok", YEAR ( [Date] ),
				        "Kwartał", "Q" & QUARTER ( [Date] ),
				        "Rok kwartał", YEAR ( [Date] ) & " Q" & QUARTER ( [Date] ),
				        "Rok kwartał nr", YEAR ( [Date] ) * 10 + QUARTER ( [Date] ),
				        "Miesiąc nr", MONTH ( [Date] ),
				        "Miesiąc",
				            SWITCH ( MONTH ( [Date] ),
				                1, "styczeń", 2, "luty", 3, "marzec", 4, "kwiecień", 5, "maj", 6, "czerwiec",
				                7, "lipiec", 8, "sierpień", 9, "wrzesień", 10, "październik", 11, "listopad", 12, "grudzień" ),
				        "Miesiąc skrót",
				            SWITCH ( MONTH ( [Date] ),
				                1, "sty", 2, "lut", 3, "mar", 4, "kwi", 5, "maj", 6, "cze",
				                7, "lip", 8, "sie", 9, "wrz", 10, "paź", 11, "lis", 12, "gru" ),
				        "Rok miesiąc", FORMAT ( [Date], "yyyy-mm" ),
				        "Rok miesiąc nr", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				        "Dzień", DAY ( [Date] ),
				        "Dzień tygodnia nr", WEEKDAY ( [Date], 2 ),          -- 1 = poniedziałek
				        "Dzień tygodnia",
				            SWITCH ( WEEKDAY ( [Date], 2 ),
				                1, "poniedziałek", 2, "wtorek", 3, "środa", 4, "czwartek",
				                5, "piątek", 6, "sobota", 7, "niedziela" ),
				        "Tydzień ISO", WEEKNUM ( [Date], 21 ),
				        "Koniec miesiąca", [Date] = EOMONTH ( [Date], 0 ),
				        "Koniec kwartału", [Date] = EOMONTH ( [Date], 0 ) && MOD ( MONTH ( [Date] ), 3 ) = 0,
				        "Święto",
				            -- Wielkanoc: algorytm Meeusa (kalendarz gregoriański)
				            VAR y = YEAR ( [Date] )
				            VAR a = MOD ( y, 19 )
				            VAR b = INT ( y / 100 )
				            VAR c = MOD ( y, 100 )
				            VAR d = INT ( b / 4 )
				            VAR e = MOD ( b, 4 )
				            VAR f = INT ( ( b + 8 ) / 25 )
				            VAR g = INT ( ( b - f + 1 ) / 3 )
				            VAR h = MOD ( 19 * a + b - d - g + 15, 30 )
				            VAR i = INT ( c / 4 )
				            VAR k = MOD ( c, 4 )
				            VAR l = MOD ( 32 + 2 * e + 2 * i - h - k, 7 )
				            VAR m = INT ( ( a + 11 * h + 22 * l ) / 451 )
				            VAR Wielkanoc =
				                DATE ( y, INT ( ( h + l - 7 * m + 114 ) / 31 ), MOD ( h + l - 7 * m + 114, 31 ) + 1 )
				            VAR md = MONTH ( [Date] ) * 100 + DAY ( [Date] )
				            RETURN
				                SWITCH ( TRUE (),
				                    md = 101,  "Nowy Rok",
				                    md = 106,  "Święto Trzech Króli",
				                    [Date] = Wielkanoc,      "Wielkanoc",
				                    [Date] = Wielkanoc + 1,  "Poniedziałek Wielkanocny",
				                    md = 501,  "Święto Pracy",
				                    md = 503,  "Święto Konstytucji 3 Maja",
				                    [Date] = Wielkanoc + 49, "Zielone Świątki",
				                    [Date] = Wielkanoc + 60, "Boże Ciało",
				                    md = 815,  "Wniebowzięcie NMP",
				                    md = 1101, "Wszystkich Świętych",
				                    md = 1111, "Narodowe Święto Niepodległości",
				                    md = 1224 && y >= 2025, "Wigilia Bożego Narodzenia",
				                    md = 1225, "Boże Narodzenie",
				                    md = 1226, "Drugi dzień Bożego Narodzenia",
				                    BLANK ()
				                )
				    )
				RETURN
				    ADDCOLUMNS (
				        _Baza,
				        "Dzień roboczy", ISBLANK ( [Święto] ) && [Dzień tygodnia nr] <= 5,
				        "Dzień wolny", NOT ISBLANK ( [Święto] ) || [Dzień tygodnia nr] >= 6
				    )

	annotation PBI_Id = abc8acde0d524a808871893a61cbd8f0

