	partition gold_dim_pozycja = m
		mode: import
		queryGroup: 03_gold
		source =
				let
				    Source = Csv.Document(File.Contents(FolderDanych & "fsv\data\fs_line.csv"),[Delimiter=",", Columns=12, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"statement", type text}, {"line_id", type text}, {"line_code", type text}, {"line_name", type text}, {"parent_line_id", type text}, {"level", Int64.Type}, {"sort_order", Int64.Type}, {"line_type", type text}, {"formula", type text}, {"display_sign", Int64.Type}, {"is_bold", Int64.Type}, {"adds_result", type text}}),
				    #"Added Conditional Column" = Table.AddColumn(#"Changed Type", "Custom", each if [line_type] = "FORMULA" then -1 else [display_sign]),
				    #"Renamed Columns" = Table.RenameColumns(#"Added Conditional Column",{{"Custom", "znak"}}),
				    #"Dodana etykieta" = Table.AddColumn(#"Renamed Columns", "pozycja",
				    each Text.Repeat(Character.FromNumber(160), 4 * [level]) & [line_code] & " " & [line_name], type text),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Dodana etykieta",{{"znak", Int64.Type}})
				in
				    #"Changed Type1"

